# Required API Keys
# If using Gemini (recommended for context):
GOOGLE_API_KEY=your_google_api_key_here

# Optional: CrewAI Gemini model (default in code: gemini/gemini-2.0-flash)
# CREWAI_GEMINI_MODEL=gemini/gemini-1.5-flash
# CREWAI_GEMINI_MODEL=gemini/gemini-1.5-pro

# Alternatively, if using OpenAI:
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: LangChain for tracking logs (CrewAI best practice)
# LANGCHAIN_API_KEY=your_langchain_api_key_here
# LANGCHAIN_PROJECT=VR-Architecture-Audit-Crew
# LangSmith Tracing (Optional but Recommended)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT="VR-Architecture-Audit-Flow"
